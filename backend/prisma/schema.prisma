generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  login        String   @unique
  passwordHash String
  phone        String
  role         String   // 'superadmin', 'admin', 'teacher', 'instructor'
  isActive     Boolean  @default(true)

  // Fields for Instructor role
  carModel     String?
  carNumber    String?
  transmission String?  // 'manual', 'auto'
  studentPrice Decimal?  @default(200000) // Instructor's fee per student, 'auto'

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])

  groupsAsTeacher Group[] @relation("TeacherGroups")
  studentsAdded   Student[] @relation("StudentCreator")
  paymentsAdded   Payment[] @relation("PaymentAdder")
  cashReports     CashReport[]
  expensesAdded   Expense[] @relation("ExpenseAdder")

  studentsAsInstructor Student[] @relation("StudentInstructor")
  drivingLessons       DrivingLesson[] @relation("InstructorLessons")
  practiceAssignments  PracticeAssignment[] @relation("InstructorAssignments")
  practiceGroups       PracticeGroup[] @relation("InstructorPracticeGroups")
  
  instructorPaymentsReceived InstructorPayment[] @relation("InstructorPayments")
  instructorPaymentsAdded    InstructorPayment[] @relation("InstructorPaymentAdder")
  
  attendancesTaken           Attendance[] @relation("TeacherAttendances")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users     User[]
  groups    Group[]
  students  Student[]
  payments  Payment[]
  cashReports CashReport[]
  expenses  Expense[]
  instructorPayments InstructorPayment[]
  practiceGroups PracticeGroup[]
}

model Group {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("active") // 'active', 'completed'
  schedule  Json     // e.g. [{ day: 'mon', startTime: '09:00', type: 'theory' }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  // Relations
  teacherId String
  teacher   User     @relation("TeacherGroups", fields: [teacherId], references: [id])
  
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])

  students  Student[]
  attendances Attendance[]
}

model PracticeGroup {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("active") // 'active', 'completed'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  instructorId String
  instructor   User     @relation("InstructorPracticeGroups", fields: [instructorId], references: [id])
  
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])

  students  Student[]
}

model Student {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  phone             String
  coursePrice       Decimal
  paidAmount        Decimal    @default(0)
  status            String   @default("active") // 'active', 'completed', 'stopped'
  providedDocuments Json?    // e.g. { photo: true, form083: true, passport: true }

  drivingHoursRequired Float    @default(20)
  drivingHoursDone     Float    @default(0)
  transmissionPreference String? // 'manual', 'auto'

  pinfl             String?
  passport          String?
  additionalPhone   String?

  // Theory workflow
  theoryCompletedAt   DateTime? // When admin marks theory complete
  readyForPractice    Boolean   @default(false) // Manual flag by admin

  // Practice workflow
  practiceStatus      String?   @default("not_started") // 'not_started', 'waiting', 'in_progress', 'completed'
  practiceStartedAt   DateTime? // When moved to waiting
  practiceCompletedAt DateTime? // When admin approves completion
  practiceGroupId     String?   
  practiceGroup       PracticeGroup? @relation(fields: [practiceGroupId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])

  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])

  createdBy String
  creator   User     @relation("StudentCreator", fields: [createdBy], references: [id])

  instructorId String?
  instructor   User?    @relation("StudentInstructor", fields: [instructorId], references: [id])

  payments  Payment[]
  drivingLessons DrivingLesson[]
  practiceAssignments PracticeAssignment[]
  attendanceRecords AttendanceRecord[]
}

model Payment {
  id        String   @id @default(uuid())
  amount    Decimal
  method    String   @default("naqd") // "naqd", "karta", "hisob"
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  // Relations
  studentId    String
  branchId     String
  addedBy      String
  cashReportId String?

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch     Branch      @relation(fields: [branchId], references: [id])
  adder      User        @relation("PaymentAdder", fields: [addedBy], references: [id])
  cashReport CashReport? @relation(fields: [cashReportId], references: [id])

  @@index([date])
  @@index([branchId, date])
}

model CashReport {
  id          String   @id @default(uuid())
  date        DateTime
  totalAmount Decimal
  cashAmount  Decimal  @default(0)
  cardAmount  Decimal  @default(0)
  bankAmount  Decimal  @default(0)
  status      String   @default("pending") // 'pending', 'approved', 'rejected'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // Relations
  addedBy     String
  adder       User     @relation(fields: [addedBy], references: [id])

  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  
  payments    Payment[]
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String?
  userName  String
  branchId  String?
  createdAt DateTime @default(now())
}

model Expense {
  id        String   @id @default(uuid())
  amount    Decimal
  category  String   // 'salary', 'fuel', 'rent', 'tax', 'other'
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
  
  // Relations
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  
  addedBy   String
  adder     User     @relation("ExpenseAdder", fields: [addedBy], references: [id])

  @@index([date])
  @@index([branchId, date])
}

model DrivingLesson {
  id          String   @id @default(uuid())
  date        DateTime
  startTime   String   // '14:00'
  endTime     String   // '16:00'
  hours       Float
  status      String   @default("completed") // 'scheduled', 'completed', 'cancelled'
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  instructorId String
  instructor   User     @relation("InstructorLessons", fields: [instructorId], references: [id])
}

model PracticeAssignment {
  id            String   @id @default(uuid())

  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  instructorId  String
  instructor    User     @relation("InstructorAssignments", fields: [instructorId], references: [id])

  vehicleId     String   // Car identifier (carModel + carNumber or separate Vehicle entity in future)

  status        String   @default("active") // 'active', 'completed', 'cancelled'

  assignedAt    DateTime @default(now())
  startedAt     DateTime? // When first lesson logged
  completedAt   DateTime?

  hoursCompleted Float    @default(0)

  // Completion workflow
  markedReadyByInstructor Boolean  @default(false)
  markedReadyAt           DateTime?
  approvedByAdmin         Boolean  @default(false)
  approvedByAdminId       String?
  approvedAt              DateTime?

  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
  @@index([instructorId])
  @@index([status])
}

model InstructorPayment {
  id           String   @id @default(uuid())
  amount       Decimal
  type         String   // 'avans' | 'salary'
  date         DateTime
  note         String?
  createdAt    DateTime @default(now())

  // Relations
  instructorId String
  instructor   User     @relation("InstructorPayments", fields: [instructorId], references: [id], onDelete: Cascade)
  
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  addedBy      String
  adder        User     @relation("InstructorPaymentAdder", fields: [addedBy], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([instructorId, date])
}

model Attendance {
  id        String   @id @default(uuid())
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User     @relation("TeacherAttendances", fields: [teacherId], references: [id])

  records   AttendanceRecord[]

  @@unique([groupId, date])
}

model AttendanceRecord {
  id           String   @id @default(uuid())
  present      Boolean  @default(true)
  
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, studentId])
}
